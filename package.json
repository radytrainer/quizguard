{
  "name": "quizguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local src/database/seed/run.ts",
    "realtime:dev": "tsx watch --env-file=.env.local src/realtime/server.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:migrate": "docker compose -f docker-compose.prod.yml run --rm migrate",
    "loadtest:seed": "tsx --env-file=.env.local scripts/load-test/seed.ts",
    "loadtest:exam-flow": "tsx --env-file=.env.local scripts/load-test/exam-flow.ts",
    "loadtest:realtime": "tsx --env-file=.env.local scripts/load-test/realtime-connections.ts",
    "loadtest:cleanup": "tsx --env-file=.env.local scripts/load-test/cleanup.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.0",
    "@next/env": "^16.3.1",
    "@node-rs/bcrypt": "^1.10.8",
    "@swc/helpers": "^0.5.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "googleapis": "^174.0.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "papaparse": "^5.6.0",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/autocannon": "^7.12.7",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "ioredis-mock": "^8.13.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
