# Loaded automatically when NODE_ENV=test (Vitest's default), since Next.js intentionally
# skips .env.local under the test environment so tests behave the same for everyone. Safe to
# commit — points at the same local docker-compose services as .env.example. Unit tests never
# reach a real connection; tests/integration/* does, via `pnpm docker:up`.
NODE_ENV=test
DATABASE_URL=postgresql://quizguard:quizguard_dev_password@localhost:55432/quizguard
REDIS_URL=redis://localhost:6379
