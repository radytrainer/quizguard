# Copy to .env.local for local development: cp .env.example .env.local

NODE_ENV=development

# PostgreSQL — must match docker-compose.yml service credentials for local dev
DATABASE_URL=postgresql://quizguard:quizguard_dev_password@localhost:55432/quizguard

# Redis
REDIS_URL=redis://localhost:6379

# Auth — introduced in Phase 1. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google Sheets import — introduced in Phase 5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Error monitoring — introduced in Phase 11
SENTRY_DSN=

# Realtime — introduced in Phase 9. The realtime server (src/realtime/server.ts) is a separate
# Node process from the Next.js app (Next 16's `output: "standalone"` build can't host a
# WebSocket server in-process — see docs/ARCHITECTURE.md, Section 12). APP_URL is the Next app's
# own origin, used for the realtime server's CORS allow-list. REALTIME_PORT is what the realtime
# server listens on. NEXT_PUBLIC_REALTIME_URL is baked into the browser bundle at build time —
# it's how the client knows where to open the WebSocket connection.
APP_URL=http://localhost:3000
REALTIME_PORT=4001
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
